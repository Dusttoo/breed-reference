{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://breed-reference.local/schema/mixes.schema.json",
  "title": "Named Dog Mixes",
  "type": "object",
  "required": ["schemaVersion", "species", "mixes"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "species": { "const": "dog" },
    "mixes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "slug", "aliases", "parentBreedIds", "sources"],
        "properties": {
          "id": { "type": "string", "pattern": "^dog-mix:[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "aliases": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "parentBreedIds": {
            "description": "Every canonical breed in the named cross's foundation, unordered: two for a first cross, more for a multi-breed or multigenerational mix.",
            "type": "array",
            "items": { "type": "string", "pattern": "^dog:[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "minItems": 2,
            "maxItems": 6,
            "uniqueItems": true
          },
          "parentMixIds": {
            "description": "Named mixes this mix was developed from. Each parent mix's foundation breeds must also appear in parentBreedIds.",
            "type": "array",
            "items": { "type": "string", "pattern": "^dog-mix:[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "minItems": 1,
            "uniqueItems": true
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/source" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "retrievedAt": { "type": "string", "format": "date" },
        "note": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
