{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://breed-reference.local/schema/classifications.schema.json",
  "title": "Species Breed Classifications",
  "type": "object",
  "required": ["$schema", "schemaVersion", "species", "taxonomies", "categories", "memberships"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "species": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "taxonomies": { "type": "array", "items": { "$ref": "#/$defs/taxonomy" } },
    "categories": { "type": "array", "items": { "$ref": "#/$defs/category" } },
    "memberships": { "type": "array", "items": { "$ref": "#/$defs/membership" } }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?::[a-z0-9]+(?:-[a-z0-9]+)*)+$"
    },
    "status": {
      "enum": ["current", "historical", "pending-recognition"]
    },
    "provenance": {
      "type": "object",
      "required": ["source", "retrievedAt"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "reference": { "type": "string", "minLength": 1 },
        "retrievedAt": { "type": "string", "format": "date" },
        "effectiveFrom": { "type": "string", "format": "date" },
        "effectiveTo": { "type": "string", "format": "date" },
        "note": { "type": "string", "minLength": 1 }
      },
      "anyOf": [
        { "required": ["url"] },
        { "required": ["reference"] }
      ],
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },
    "taxonomy": {
      "type": "object",
      "required": ["id", "name", "version", "authority", "status", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "authority": { "$ref": "#/$defs/authority" },
        "status": { "$ref": "#/$defs/status" },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/provenance" }
        }
      },
      "additionalProperties": false
    },
    "category": {
      "type": "object",
      "required": ["id", "taxonomyId", "name", "slug", "categoryType", "status", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "taxonomyId": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "categoryType": { "enum": ["group", "class", "program", "section", "division", "other"] },
        "parentId": { "$ref": "#/$defs/identifier" },
        "status": { "$ref": "#/$defs/status" },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/provenance" }
        }
      },
      "additionalProperties": false
    },
    "membership": {
      "type": "object",
      "required": ["breedId", "taxonomyId", "categoryId", "status", "provenance"],
      "properties": {
        "breedId": { "$ref": "#/$defs/identifier" },
        "taxonomyId": { "$ref": "#/$defs/identifier" },
        "categoryId": { "$ref": "#/$defs/identifier" },
        "status": { "$ref": "#/$defs/status" },
        "effectiveFrom": { "type": "string", "format": "date" },
        "effectiveTo": { "type": "string", "format": "date" },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/provenance" }
        }
      },
      "additionalProperties": false
    }
  }
}
